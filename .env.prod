# ================================================
# NL2SQL 生产环境变量
# 部署服务器：8.163.4.42（阿里云 ECS）
# ================================================

# ── LLM ──
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ── Langfuse（服务器已有 Langfuse v4.16.0 @ :3001）──
LANGFUSE_ENABLE=true
LANGFUSE_SECRET_KEY=sk-lf-35bffdb3-166f-42e9-808f-d92d3ff6e1d4
LANGFUSE_PUBLIC_KEY=pk-lf-52a20c6b-81ed-4d12-8f2f-df98710c4209
LANGFUSE_BASE_URL=http://8.163.4.42:3001
LANGFUSE_PROJECT_ID=proj_7qzwty81
LANGFUSE_RELEASE=v1.0.0

# ── Wren ──
WREN_BIN_PATH=wren
WREN_MEMORY_BACKEND=grep

# ── Checkpoint（宿主机 PostgreSQL 14.24，通过 Docker 网关 172.17.0.1 访问）──
CHECKPOINT_DB_URI=postgresql://nl2sql:nl2sql_secret@172.17.0.1:5432/nl2sql_checkpoint

# ── 图表引擎 ──
CHART_ENGINE=echarts

# ── 数据库配置加密密钥 ──
DB_CONFIG_SECRET=b40629feb5e52e157b9065cb0626be7f

# ── Custom App（合并进 LangGraph API 同端口 2026）──
LANGGRAPH_HTTP={"app": "src/api/custom_app.py:app"}

# ── 业务数据库（MySQL）──
DB_TYPE=mysql

DB_1_NAME=aix_report
