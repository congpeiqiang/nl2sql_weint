{
  "user_intent": {
    "original_question": "查询投票数（num_votes）超过 100 万的电影数量",
    "domain": "imdb",
    "keywords": ["电影", "投票数", "num_votes", "100万", "数量"],
    "intent_type": "count_movies_by_votes"
  },
  "entities": {
    "filters": [
      {"field": "titles.title_type", "operator": "=", "value": "movie"},
      {"field": "titles.num_votes", "operator": ">", "value": 1000000}
    ],
    "fields_to_display": ["COUNT(*)"]
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_movie",
      "name": "电影类型定义",
      "condition": "titles.title_type = 'movie'"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "投票数": "titles.num_votes",
    "数量": "COUNT(*)"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "电影定义",
      "content": "title_type = 'movie' 才是电影，titles 表包含9种作品类型"
    },
    {
      "topic": "投票数字段",
      "content": "num_votes 在 titles 表中，为 INTEGER 类型"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.title_type", "titles.num_votes"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.num_votes > 1000000"]
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "B"
  }
}
