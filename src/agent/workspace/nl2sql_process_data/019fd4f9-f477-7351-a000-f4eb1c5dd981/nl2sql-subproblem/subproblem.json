{
  "SELECT": [
    "FLOOR(t.start_year / 10) * 10 AS decade",
    "ROUND(AVG(t.average_rating), 2) AS avg_rating",
    "COUNT(*) AS movie_count"
  ],
  "FROM": "titles t",
  "JOIN": null,
  "WHERE": [
    "t.title_type = 'movie'",
    "t.start_year IS NOT NULL"
  ],
  "GROUP_BY": "FLOOR(t.start_year / 10) * 10",
  "HAVING": null,
  "ORDER_BY": "decade ASC",
  "LIMIT": null
}
