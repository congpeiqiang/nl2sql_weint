{
  "user_intent": {
    "original_question": "查询每个年代（decade）电影的平均评分和电影数量",
    "domain": "imdb",
    "keywords": ["年代", "decade", "电影", "平均评分", "电影数量"],
    "intent_type": "query_decade_movie_stats"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"}
    ],
    "fields_to_display": ["decade", "平均评分", "电影数量"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg_rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    },
    {
      "name": "电影数量",
      "aliases": ["电影数", "movie_count", "count"],
      "formula": "COUNT(*)",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "年代划分公式",
      "condition": "FLOOR(start_year / 10) * 10",
      "note": "示例：1994 → 1990, 2005 → 2000, 2023 → 2020"
    },
    {
      "id": "rule_002",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'",
      "note": "只有 title_type='movie' 才是电影，titles 表包含9种作品类型"
    },
    {
      "id": "rule_003",
      "name": "NULL值处理",
      "condition": "start_year IS NOT NULL",
      "note": "start_year 可能为 NULL，查询时建议 WHERE start_year IS NOT NULL"
    }
  ],
  "field_mappings": {
    "年代": {"table": "titles", "field": "FLOOR(start_year / 10) * 10"},
    "平均评分": {"table": "titles", "field": "average_rating"},
    "电影数量": {"table": "titles", "field": "COUNT(*)"}
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "评分可信度",
      "content": "排名类查询应加 num_votes > 10000 过滤；低投票数影片评分不可靠"
    },
    {
      "topic": "表关系",
      "content": "titles 表包含所有作品信息，评分和投票数已合并到此表"
    },
    {
      "topic": "字段说明",
      "content": "titles.average_rating 范围 1.0-10.0；titles.start_year 为上映年份"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.start_year", "titles.average_rating", "titles.title_type"],
