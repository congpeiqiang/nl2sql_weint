{
  "SELECT": "COUNT(DISTINCT t.id) AS movie_count",
  "FROM": "titles t",
  "JOIN": [
    {"table": "titles_genres tg", "on": "tg.title_id = t.id"},
    {"table": "genres g", "on": "g.id = tg.genre_id"}
  ],
  "WHERE": [
    "t.title_type = 'movie'",
    "g.id = 'comedy'"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": null,
  "LIMIT": null
}
