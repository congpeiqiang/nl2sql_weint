{
  "SELECT": "names.primary_name AS actor_name, principals.ordering",
  "FROM": "titles t",
  "JOIN": [
    {"table": "principals p", "on": "p.title_id = t.id"},
    {"table": "names n", "on": "p.name_id = n.id"}
  ],
  "WHERE": [
    "t.primary_title = 'The Matrix'",
    "t.title_type = 'movie'",
    "p.category_id IN ('actor', 'actress')"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "principals.ordering ASC",
  "LIMIT": null
}
