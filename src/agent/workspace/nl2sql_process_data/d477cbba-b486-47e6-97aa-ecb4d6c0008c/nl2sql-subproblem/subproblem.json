{
  "SELECT": [
    {"field": "names.primary_name", "alias": "演员姓名"},
    {"field": "COUNT(DISTINCT principals.title_id)", "alias": "参演电影数量"}
  ],
  "FROM": [
    {"table": "names", "alias": "n"},
    {"table": "principals", "alias": "p"},
    {"table": "titles", "alias": "t"}
  ],
  "JOIN": [
    {"table": "principals", "alias": "p", "on": "p.name_id = n.id"},
    {"table": "titles", "alias": "t", "on": "p.title_id = t.id"}
  ],
  "WHERE": [
    {"condition": "p.category_id IN ('actor', 'actress')", "reason": "演员定义规则，包含男女演员"},
    {"condition": "t.title_type = 'movie'", "reason": "只统计电影类型作品"}
  ],
  "GROUP_BY": [
    {"field": "n.id"},
    {"field": "n.primary_name"}
  ],
  "HAVING": [],
  "ORDER_BY": [
    {"field": "参演电影数量", "direction": "DESC"}
  ],
  "LIMIT": 13
}
