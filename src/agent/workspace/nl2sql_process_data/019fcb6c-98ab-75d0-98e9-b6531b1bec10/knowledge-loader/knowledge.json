    {
      "id": "rule_002",
      "name": "start_year可能为NULL",
      "condition": "start_year IS NOT NULL"
    },
    {
      "id": "rule_003",
      "name": "年代划分公式",
      "condition": "FLOOR(start_year / 10) * 10，1990年代即 start_year BETWEEN 1990 AND 1999"
    }
  ],
  "field_mappings": {
