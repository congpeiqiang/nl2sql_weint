      {"field": "start_year", "operator": "<=", "value": 1999}
    ],
    "fields_to_display": ["平均评分 (AVG(average_rating))"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["average rating", "均分"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "只查电影",
      "condition": "title_type = 'movie'"
