  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "评分可信度",
      "content": "投票数 < 1000 的评分偏差大，不建议用于排名。排名类查询应加 num_votes > 10000 过滤。但本题是求平均值，非排名，可不加此过滤。"
    },
    {
      "topic": "NULL值处理",
      "content": "start_year 可能为 NULL，查询时建议 WHERE start_year IS NOT NULL"
    },
    {
      "topic": "作品类型",
      "content": "titles 表包含9种作品类型，查电影需过滤 title_type='movie'"
    }
  ],
