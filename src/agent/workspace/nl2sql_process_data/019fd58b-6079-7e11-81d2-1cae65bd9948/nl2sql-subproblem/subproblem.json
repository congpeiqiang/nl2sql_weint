{
  "SELECT": "系列标题(primary_title)、第一季平均评分、后续季平均评分、衰退幅度(第一季平均评分 - 后续季平均评分)、总季数",
  "FROM": "titles s (系列), episodes e, titles ep (剧集)",
  "JOIN": [
    {"table": "episodes e", "on": "s.id = e.parent_id (系列→剧集)"},
    {"table": "titles ep", "on": "e.id = ep.id (剧集→自身标题)"}
  ],
  "WHERE": [
    "s.title_type = 'tvSeries'",
    "ep.average_rating IS NOT NULL",
    "e.season_number IS NOT NULL"
  ],
  "GROUP_BY": "s.id, s.primary_title",
  "HAVING": "系列至少包含第一季和后续季(即至少2季)",
  "ORDER_BY": "衰退幅度 DESC",
  "LIMIT": "10 (通过run_sql的limit参数控制)"
}
