{
  "SELECT": "titles.primary_title AS 标题, titles.average_rating AS 评分",
  "FROM": "titles",
  "JOIN": null,
  "WHERE": [
    "titles.title_type = 'movie'",
    "titles.num_votes >= 50000",
    "titles.average_rating IS NOT NULL"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "titles.average_rating DESC",
  "LIMIT": 10
}
