{
  "SELECT": "n.primary_name, actor_movie_count, actor_avg_rating, director_movie_count, director_avg_rating",
  "FROM": "names n, principals p, titles t",
  "JOIN": [
    {"table": "principals p", "on": "p.title_id = t.id"},
    {"table": "names n", "on": "p.name_id = n.id"}
  ],
  "WHERE": [
    "p.category_id IN ('actor', 'actress') OR p.category_id = 'director'",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": "n.id, n.primary_name",
  "HAVING": "演员作品数 >= 3 AND 导演作品数 >= 3",
  "ORDER_BY": "无明确要求",
  "LIMIT": "无"
}
