    "fields_to_display": ["电影数量"]
  },
  "metrics": [
    {
      "name": "电影数量",
      "aliases": ["电影部数", "电影总数"],
      "formula": "COUNT(*) FROM titles WHERE title_type='movie'",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
