{
  "user_intent": {
    "original_question": "查询投票数超过100万的电影有多少部",
    "domain": "imdb",
    "keywords": ["电影", "投票数", "100万", "数量"],
    "intent_type": "count_movies_by_votes"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "num_votes", "operator": ">", "value": 1000000}
