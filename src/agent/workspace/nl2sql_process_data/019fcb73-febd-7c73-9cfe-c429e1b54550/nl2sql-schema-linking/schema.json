{
  "tables": [
    {
      "name": "titles",
      "description": "IMDb 核心作品表。包含所有电影、短片、电视剧集等信息，约1000万+条记录。评分和投票数已从 ratings 表合并到此表。",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头7-8位字符串)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvEpisode/tvSeries/tvMovie/tvMiniSeries/tvSpecial/video/videoGame"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "original_title", "type": "VARCHAR", "description": "原始标题"},
        {"name": "is_adult", "type": "INTEGER", "description": "是否成人内容 (0/1)"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份"},
        {"name": "end_year", "type": "INTEGER", "description": "终映年份 (电视剧/系列使用, 电影通常为NULL)"},
        {"name": "runtime_minutes", "type": "INTEGER", "description": "片长(分钟)"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分(1.0-10.0)"},
        {"name": "num_votes", "type": "INTEGER", "description": "用户投票总数"}
      ]
    }
  ],
  "relations": [],
  "field_mappings": {
    "电影": {"table": "titles", "field": "title_type", "condition": "= 'movie'"},
    "评分": {"table": "titles", "field": "average_rating"},
    "年份": {"table": "titles", "field": "start_year"},
    "平均评分": {"table": "titles", "field": "average_rating", "aggregation": "AVG"}
  },
  "query_relevant_columns": ["title_type", "start_year", "average_rating"],
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "note": "单表查询，仅需 titles 表"
  }
}
