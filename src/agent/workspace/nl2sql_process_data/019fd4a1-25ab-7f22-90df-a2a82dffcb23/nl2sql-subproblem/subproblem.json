{
  "SELECT": "年代(decade) = FLOOR(t.start_year / 10) * 10, 平均评分 = AVG(t.average_rating), 电影数量 = COUNT(*)",
  "FROM": "titles t",
  "JOIN": null,
  "WHERE": [
    "t.title_type = 'movie'",
    "t.start_year IS NOT NULL"
  ],
  "GROUP_BY": "FLOOR(t.start_year / 10) * 10",
  "HAVING": null,
  "ORDER_BY": "decade ASC",
  "LIMIT": null
}
