    }
  ],
  "business_rules": [
    {
      "id": "rule_decade",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10",
      "note": "示例：1994 → 1990, 2005 → 2000, 2023 → 2020"
    },
    {
      "id": "rule_movie",
      "name": "电影类型",
      "condition": "t.title_type = 'movie'",
      "note": "titles 表包含9种作品类型，需过滤 title_type='movie' 才是电影"
    },
    {
      "id": "rule_null_year",
      "name": "start_year NULL处理",
      "condition": "WHERE start_year IS NOT NULL",
      "note": "start_year 可能为 NULL，查询时需过滤"
    },
    {
      "id": "rule_null_rating",
      "name": "average_rating NULL处理",
      "condition": "average_rating IS NOT NULL",
      "note": "评分可能为 NULL"
    }
  ],
  "field_mappings": {
    "年代": "FLOOR(titles.start_year / 10) * 10",
    "平均评分": "AVG(titles.average_rating)",
    "电影数量": "COUNT(*)",
    "电影": "titles.title_type = 'movie'"
  },
