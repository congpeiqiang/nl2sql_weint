{
  "user_intent": {
    "original_question": "列出时长大于 180 分钟的电影标题和片长，按片长降序排列。",
    "domain": "imdb",
    "keywords": ["电影", "时长", "片长", "180分钟", "标题", "降序"],
    "intent_type": "query_movies_by_runtime"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "runtime_minutes", "operator": ">", "value": 180}
    ],
    "fields_to_display": ["primary_title", "runtime_minutes"],
    "order_by": {"field": "runtime_minutes", "direction": "DESC"}
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_movie",
      "name": "电影类型过滤",
      "condition": "titles.title_type = 'movie'",
      "note": "title_type='movie' 才是电影，titles 表包含9种作品类型"
    },
    {
      "id": "rule_runtime_null",
      "name": "片长NULL处理",
      "condition": "runtime_minutes IS NOT NULL",
      "note": "runtime_minutes 可能为 NULL，查询时应过滤"
    }
  ],
  "field_mappings": {
    "电影标题": "titles.primary_title",
    "片长": "titles.runtime_minutes",
    "电影": "titles.title_type = 'movie'"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "表关系",
      "content": "本查询仅涉及 titles 单表，无需 JOIN"
    },
    {
      "topic": "字段说明",
      "content": "titles.runtime_minutes 为片长(分钟)，电影一般有值，剧集通常为 NULL"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.primary_title", "titles.runtime_minutes"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.runtime_minutes > 180"],
    "order_by": "titles.runtime_minutes DESC"
  },
