{
  "tables": [
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb唯一人物标识"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名"},
        {"name": "birth_year", "type": "INTEGER", "description": "出生年份"},
        {"name": "death_year", "type": "INTEGER", "description": "逝世年份(NULL=健在)"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true, "description": "自增主键"},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "作品ID, 关联titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "人物ID, 关联names.id"},
        {"name": "ordering", "type": "INTEGER", "description": "排序号(1=最主要)"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别(actor/actress等)"},
        {"name": "job_id", "type": "VARCHAR", "description": "具体职位"}
      ]
    },
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb唯一作品标识"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份"},
        {"name": "end_year", "type": "INTEGER", "description": "终映年份"},
        {"name": "runtime_minutes", "type": "INTEGER", "description": "片长"},
        {"name": "average_rating", "type": "DOUBLE", "description": "平均评分"},
        {"name": "num_votes", "type": "INTEGER", "description": "投票数"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    }
  ],
  "field_mappings": {
    "演员名": {"table": "names", "field": "primary_name"},
    "职业生涯跨度": {"table": "titles", "field": "start_year", "formula": "MAX(start_year) - MIN(start_year)"},
    "演员类别": {"table": "principals", "field": "category_id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
