{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb唯一作品标识"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries/tvEpisode/tvMovie/tvMiniSeries/tvSpecial/video/videoGame"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份"},
        {"name": "end_year", "type": "INTEGER", "description": "终映年份(电视剧系列专用)"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分"},
        {"name": "num_votes", "type": "INTEGER", "description": "用户投票总数"}
      ]
    },
    {
      "name": "titles_genres",
      "columns": [
        {"name": "title_id", "type": "VARCHAR", "pk": true, "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "genre_id", "type": "VARCHAR", "pk": true, "fk": true, "description": "类型ID, 关联 genres.id"}
      ]
    },
    {
      "name": "genres",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "类型标识符(字符串): action/comedy/drama等"},
        {"name": "display_name", "type": "VARCHAR", "description": "类型显示名"}
      ]
    }
  ],
  "relations": [
    {
      "from": "titles_genres",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id"
    },
    {
      "from": "titles_genres",
      "from_field": "genre_id",
      "to": "genres",
      "to_field": "id"
    }
  ],
  "field_mappings": {
    "电视剧系列": {"table": "titles", "field": "title_type", "value": "tvSeries"},
    "年份": {"table": "titles", "field": "start_year"},
    "年代": {"table": "titles", "field": "start_year", "formula": "FLOOR(start_year / 10) * 10"},
    "类型": {"table": "genres", "field": "id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success"
  }
}
