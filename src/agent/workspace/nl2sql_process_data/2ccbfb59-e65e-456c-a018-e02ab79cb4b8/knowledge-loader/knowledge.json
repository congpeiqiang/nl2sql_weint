      "name": "增长率",
      "aliases": ["同比上一年增长率", "相比上一年增长率"],
      "formula": "(current_count - prev_count) / prev_count * 100%",
      "related_tables": ["titles"],
      "aggregation": "LAG window function"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
