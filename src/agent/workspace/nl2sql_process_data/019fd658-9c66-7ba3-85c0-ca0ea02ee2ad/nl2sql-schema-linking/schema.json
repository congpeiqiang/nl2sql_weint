{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分(1.0-10.0)"},
        {"name": "num_votes", "type": "INTEGER", "description": "用户投票总数"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true, "description": "自增主键"},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "人物ID, 关联 names.id"},
        {"name": "ordering", "type": "INTEGER", "description": "排序号(1=最主要角色)"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别: actor/actress/director等"}
      ]
    },
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头)"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名(最常用拼写形式)"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    }
  ],
  "field_mappings": {
    "导演名": {"table": "names", "field": "primary_name"},
    "演员名": {"table": "names", "field": "primary_name"},
    "合作次数": {"table": "principals", "field": "COUNT(*)"},
    "合作电影的平均评分": {"table": "titles", "field": "AVG(average_rating)"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success"
  }
}
