{
  "tables": [
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头)"},
        {"name": "primary_name", "type": "VARCHAR", "pk": false, "description": "全名(最常用拼写形式)"},
        {"name": "birth_year", "type": "INTEGER", "pk": false, "description": "出生年份"},
        {"name": "death_year", "type": "INTEGER", "pk": false, "description": "逝世年份(NULL=仍健在)"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true, "description": "自增主键"},
        {"name": "title_id", "type": "VARCHAR", "pk": false, "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "pk": false, "fk": true, "description": "人物ID, 关联 names.id"},
        {"name": "ordering", "type": "INTEGER", "pk": false, "description": "排序号(1=最主要角色)"},
        {"name": "category_id", "type": "VARCHAR", "pk": false, "description": "职位类别 (actor/actress/director等)"},
        {"name": "job_id", "type": "VARCHAR", "pk": false, "description": "具体职位"}
      ]
    },
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头)"},
        {"name": "title_type", "type": "VARCHAR", "pk": false, "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "pk": false, "description": "主要标题"},
        {"name": "start_year", "type": "INTEGER", "pk": false, "description": "首映/发布年份"},
        {"name": "end_year", "type": "INTEGER", "pk": false, "description": "终映年份(电视剧系列专用)"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    }
  ],
  "field_mappings": {
    "演员名": {"table": "names", "field": "primary_name"},
    "职业生涯跨度": {"table": "titles", "field": "MAX(start_year) - MIN(start_year)"},
    "作品年份": {"table": "titles", "field": "start_year"},
    "演员类别": {"table": "principals", "field": "category_id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
