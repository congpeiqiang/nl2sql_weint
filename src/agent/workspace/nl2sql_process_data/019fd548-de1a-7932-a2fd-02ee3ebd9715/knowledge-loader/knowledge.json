{
  "user_intent": {
    "original_question": "查询每个年代（decade）电影的平均评分和电影数量。需要按电影上映年份所属的年代（如1950s、1960s、1970s等）进行分组，统计每个年代的电影数量和平均评分。",
    "domain": "imdb",
    "keywords": ["年代", "decade", "电影", "平均评分", "电影数量", "上映年份", "分组"],
    "intent_type": "query_decade_movie_stats"
  },
  "entities": {
    "time_range": null,
    "filters": [{"field": "title_type", "operator": "=", "value": "movie"}],
    "fields_to_display": ["decade", "movie_count", "avg_rating"],
    "group_by": ["decade"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    },
    {
      "name": "电影数量",
      "aliases": ["电影数", "count", "movie count"],
      "formula": "COUNT(*)",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_decade",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10",
      "note": "1994 → 1990, 2005 → 2000, 2023 → 2020"
    },
    {
      "id": "rule_movie",
      "name": "电影类型",
      "condition": "t.title_type = 'movie'",
      "note": "只有 title_type='movie' 才是电影"
    },
    {
      "id": "rule_null_start_year",
      "name": "start_year NULL处理",
      "condition": "WHERE start_year IS NOT NULL",
      "note": "start_year 可能为 NULL，需过滤"
    }
  ],
  "field_mappings": {
    "年代": "FLOOR(titles.start_year / 10) * 10",
    "平均评分": "AVG(titles.average_rating)",
    "电影数量": "COUNT(*)",
    "上映年份": "titles.start_year"
  },
