{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries等"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分(1.0-10.0)"}
      ]
    }
  ],
  "relations": [],
  "field_mappings": {
    "年代(decade)": {"table": "titles", "field": "FLOOR(start_year / 10) * 10"},
    "平均评分": {"table": "titles", "field": "AVG(average_rating)"},
    "电影数量": {"table": "titles", "field": "COUNT(*)"},
    "上映年份": {"table": "titles", "field": "start_year"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "note": "单表查询，仅需 titles 表。按 title_type='movie' 过滤，按 FLOOR(start_year/10)*10 分组。"
  }
}
