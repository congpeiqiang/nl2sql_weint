        {"name": "primary_title", "type": "VARCHAR", "note": "主要标题（通常为原始语言标题）"},
        {"name": "original_title", "type": "VARCHAR", "note": "原始标题"},
        {"name": "is_adult", "type": "INTEGER", "note": "0/1"},
        {"name": "start_year", "type": "INTEGER", "note": "首映年份，可能 NULL"},
        {"name": "end_year", "type": "INTEGER", "note": "电视剧系列专用"},
        {"name": "runtime_minutes", "type": "INTEGER", "note": "片长，剧集通常 NULL"},
        {"name": "average_rating", "type": "DOUBLE", "note": "加权平均评分 1.0-10.0"},
        {"name": "num_votes", "type": "INTEGER", "note": "投票总数"}
      ]
    }
  ],
  "relations": [
    {"from": "principals", "from_field": "title_id", "to": "titles", "to_field": "id", "note": "参与者→作品"},
    {"from": "titles_genres", "from_field": "title_id", "to": "titles", "to_field": "id", "note": "作品-类型"},
    {"from": "names_knownfortitles", "from_field": "title_id", "to": "titles", "to_field": "id", "note": "人物代表作"},
    {"from": "episodes", "from_field": "parent_id", "to": "titles", "to_field": "id", "note": "剧集→父系列"},
    {"from": "episodes", "from_field": "id", "to": "titles", "to_field": "id", "note": "剧集→自身标题"},
    {"from": "titleakas", "from_field": "title_id", "to": "titles", "to_field": "id", "note": "作品别名"}
  ],
  "field_mappings": {
    "影视剧/作品名": {"table": "titles", "field": "primary_title"},
