{
  "SELECT": "AVG(t.average_rating) AS avg_rating",
  "FROM": "titles t",
  "JOIN": [
    {"table": "principals p", "on": "p.title_id = t.id"},
    {"table": "names n", "on": "p.name_id = n.id"}
  ],
  "WHERE": [
    "n.primary_name = 'Christopher Nolan'",
    "p.category_id = 'director'",
    "t.title_type = 'movie'",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": null,
  "LIMIT": null
}
