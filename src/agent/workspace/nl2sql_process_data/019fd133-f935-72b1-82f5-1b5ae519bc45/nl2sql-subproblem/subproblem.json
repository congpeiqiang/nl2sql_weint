{
  "SELECT": [
    "n.primary_name AS 演员姓名",
    "COUNT(DISTINCT p.title_id) AS 参演电影数",
    "ROUND(AVG(t.average_rating), 2) AS 平均评分"
  ],
  "FROM": [
    {"table": "names", "alias": "n"},
    {"table": "principals", "alias": "p"},
    {"table": "titles", "alias": "t"}
  ],
  "JOIN": [
    {"table": "principals p", "on": "p.name_id = n.id"},
    {"table": "titles t", "on": "t.id = p.title_id"}
  ],
  "WHERE": [
    "p.category_id IN ('actor', 'actress')",
    "t.title_type = 'movie'",
    "t.num_votes > 50000"
  ],
  "GROUP_BY": ["n.id", "n.primary_name"],
  "HAVING": ["COUNT(DISTINCT p.title_id) >= 5"],
  "ORDER_BY": ["平均评分 DESC"],
  "LIMIT": 10
}
