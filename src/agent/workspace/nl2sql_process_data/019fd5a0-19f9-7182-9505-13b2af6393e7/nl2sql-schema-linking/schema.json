{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分(1.0-10.0)"},
        {"name": "num_votes", "type": "INTEGER", "description": "用户投票总数"},
        {"name": "start_year", "type": "INTEGER", "description": "首映年份"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "关联 names.id"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别: actor/actress/director等"}
      ]
    },
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头)"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id"
    }
  ],
  "field_mappings": {
    "导演名": {"table": "names", "field": "primary_name", "condition": "principals.category_id = 'director'"},
    "演员名": {"table": "names", "field": "primary_name", "condition": "principals.category_id IN ('actor', 'actress')"},
    "合作次数": {"table": "principals", "field": "COUNT(*)", "group_by": "导演-演员组合"},
    "平均评分": {"table": "titles", "field": "AVG(average_rating)"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql",
    "key_notes": [
      "导演: category_id = 'director'",
      "演员: category_id IN ('actor', 'actress')",
      "电影: title_type = 'movie'",
      "评分可信度: num_votes > 10000 AND average_rating IS NOT NULL",
      "需要自关联 principals 表：一次查导演(pd)，一次查演员(pa)"
    ]
  }
}
