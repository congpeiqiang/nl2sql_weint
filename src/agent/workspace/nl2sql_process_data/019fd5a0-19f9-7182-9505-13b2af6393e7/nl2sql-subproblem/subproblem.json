{
  "SELECT": [
    "d.primary_name AS director_name (导演名)",
    "a.primary_name AS actor_name (演员名)",
    "COUNT(*) AS collaboration_count (合作次数)",
    "ROUND(AVG(t.average_rating), 2) AS avg_rating (合作电影平均评分)"
  ],
  "FROM": [
    "principals pd (导演参与者，别名pd)",
    "titles t (作品表，别名t)",
    "principals pa (演员参与者，别名pa)",
    "names d (导演人物表，别名d)",
    "names a (演员人物表，别名a)"
  ],
  "JOIN": [
    {"table": "titles t", "on": "pd.title_id = t.id AND t.title_type = 'movie'"},
    {"table": "principals pa", "on": "pa.title_id = t.id AND pa.category_id IN ('actor', 'actress')"},
    {"table": "names d", "on": "pd.name_id = d.id"},
    {"table": "names a", "on": "pa.name_id = a.id"}
  ],
  "WHERE": [
    "pd.category_id = 'director' (导演)",
    "t.num_votes > 10000 (评分可信度过滤)",
    "t.average_rating IS NOT NULL (排除无评分电影)"
  ],
  "GROUP_BY": [
    "d.id, d.primary_name, a.id, a.primary_name (导演-演员组合)"
  ],
  "HAVING": [
    "COUNT(*) >= 3 (合作3次以上)",
    "AVG(t.average_rating) >= 7.5 (平均评分>=7.5)"
  ],
  "ORDER_BY": [
    "collaboration_count DESC, avg_rating DESC (按合作次数和平均评分降序)"
  ],
  "LIMIT": "通过 run_sql 的 limit 参数控制，SQL 中不写 LIMIT"
}
