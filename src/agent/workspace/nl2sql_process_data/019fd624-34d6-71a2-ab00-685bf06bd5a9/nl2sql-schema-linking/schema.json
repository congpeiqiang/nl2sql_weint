{
  "tables": [
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头)"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名(最常用拼写形式)"},
        {"name": "birth_year", "type": "INTEGER"},
        {"name": "death_year", "type": "INTEGER", "description": "NULL=仍健在"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "人物ID, 关联 names.id"},
        {"name": "ordering", "type": "INTEGER", "description": "排序号(1=最主要角色)"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别: actor/actress/director等"},
        {"name": "job_id", "type": "VARCHAR"}
      ]
    },
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR"},
        {"name": "start_year", "type": "INTEGER", "description": "首映/发布年份, 可能为NULL"},
        {"name": "end_year", "type": "INTEGER"},
        {"name": "runtime_minutes", "type": "INTEGER"},
        {"name": "average_rating", "type": "DOUBLE"},
        {"name": "num_votes", "type": "INTEGER"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "type": "MANY_TO_ONE"
    }
  ],
  "field_mappings": {
    "演员名": {"table": "names", "field": "primary_name"},
    "作品年份": {"table": "titles", "field": "start_year"},
    "演员ID": {"table": "names", "field": "id"},
    "作品ID": {"table": "titles", "field": "id"},
    "参与者作品ID": {"table": "principals", "field": "title_id"},
    "参与者人物ID": {"table": "principals", "field": "name_id"},
    "参与者类别": {"table": "principals", "field": "category_id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success"
  }
