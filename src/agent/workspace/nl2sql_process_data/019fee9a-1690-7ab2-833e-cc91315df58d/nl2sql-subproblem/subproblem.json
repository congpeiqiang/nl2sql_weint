{
  "SELECT": [
    "d.primary_name AS director_name (导演名)",
    "a.primary_name AS actor_name (演员名)",
    "COUNT(*) AS collaboration_count (合作次数)",
    "ROUND(AVG(t.average_rating), 2) AS avg_rating (平均评分)"
  ],
  "FROM": [
    "principals pd (导演参与者)",
    "titles t (电影作品)",
    "principals pa (演员参与者)",
    "names d (导演人物)",
    "names a (演员人物)"
  ],
  "JOIN": [
    {"table": "titles t", "on": "pd.title_id = t.id AND t.title_type = 'movie'"},
    {"table": "principals pa", "on": "pa.title_id = t.id AND pa.category_id IN ('actor', 'actress')"},
    {"table": "names d", "on": "pd.name_id = d.id"},
    {"table": "names a", "on": "pa.name_id = a.id"}
  ],
  "WHERE": [
    "pd.category_id = 'director'",
    "t.num_votes > 5000",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": [
    "d.id, d.primary_name, a.id, a.primary_name"
  ],
  "HAVING": [
    "COUNT(*) >= 3",
    "AVG(t.average_rating) >= 7.5"
  ],
  "ORDER_BY": [
    "collaboration_count DESC",
    "avg_rating DESC"
  ],
  "LIMIT": "通过 run_sql 的 limit 参数控制，SQL 中不写 LIMIT"
}
