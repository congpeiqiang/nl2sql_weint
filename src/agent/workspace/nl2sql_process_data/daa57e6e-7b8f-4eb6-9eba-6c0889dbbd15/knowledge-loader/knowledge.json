{
  "user_intent": {
    "original_question": "统计 2000-2023 年每年电影产量，并计算相比上一年的增长率。显示年份、电影产量、同比增长率。",
    "domain": "imdb",
    "keywords": ["电影", "产量", "年份", "增长率", "2000-2023"],
    "intent_type": "query_movie_production_trend"
  },
  "entities": {
    "time_range": {"start": 2000, "end": 2023},
    "filters": [{"field": "title_type", "operator": "=", "value": "movie"}],
    "fields_to_display": ["年份", "电影产量", "同比增长率"]
  },
  "metrics": [
    {
      "name": "电影产量",
      "aliases": ["电影数量", "产量"],
      "formula": "COUNT(DISTINCT t.id) WHERE t.title_type = 'movie'",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    },
    {
      "name": "同比增长率",
      "aliases": ["增长率", "环比增长率"],
      "formula": "(current_year_count - previous_year_count) / previous_year_count * 100",
      "related_tables": ["titles"],
      "aggregation": "LAG window function"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型定义",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "start_year NULL处理",
      "condition": "t.start_year IS NOT NULL"
    }
  ],
  "field_mappings": {
    "年份": "titles.start_year",
    "电影产量": "COUNT(DISTINCT titles.id)",
    "作品类型": "titles.title_type"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "电影定义",
      "content": "title_type = 'movie' 才是电影，titles 表包含9种作品类型"
    },
    {
      "topic": "start_year",
      "content": "start_year 可能为 NULL，查询时需 WHERE start_year IS NOT NULL"
    },
    {
      "topic": "增长率计算",
      "content": "同比增长率 = (当年产量 - 上一年产量) / 上一年产量 × 100%，使用 LAG 窗口函数获取上一年产量"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.start_year", "titles.id", "titles.title_type"],
