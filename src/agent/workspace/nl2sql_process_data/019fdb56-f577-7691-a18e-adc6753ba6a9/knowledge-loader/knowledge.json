{
  "user_intent": {
    "original_question": "列出时长大于180分钟的电影标题和片长，按片长降序排列",
    "domain": "imdb",
    "keywords": ["电影", "时长", "片长", "180分钟", "标题", "降序"],
    "intent_type": "query_movies_by_runtime"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "runtime_minutes", "operator": ">", "value": 180}
    ],
    "fields_to_display": ["primary_title", "runtime_minutes"],
    "order_by": {"field": "runtime_minutes", "direction": "DESC"}
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_movie",
      "name": "电影类型",
      "condition": "titles.title_type = 'movie'",
      "note": "movie 为长片电影，通常 runtime >= 40 分钟"
    }
  ],
  "field_mappings": {
    "电影标题": "titles.primary_title",
    "片长/时长": "titles.runtime_minutes"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "片长分类",
      "content": "runtime_minutes 为片长(分钟)，电影一般有值，电视剧集通常为 NULL"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.primary_title", "titles.runtime_minutes"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.runtime_minutes > 180"],
    "order_by": "titles.runtime_minutes DESC"
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "B"
  }
}
