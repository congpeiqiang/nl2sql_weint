{
  "SELECT": "start_year AS 年份, AVG(average_rating) AS 平均评分",
  "FROM": "titles t",
  "JOIN": null,
  "WHERE": [
    "t.title_type = 'movie'",
    "t.start_year BETWEEN 1990 AND 1999",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": "t.start_year",
  "HAVING": null,
  "ORDER_BY": "t.start_year ASC",
  "LIMIT": null
}
