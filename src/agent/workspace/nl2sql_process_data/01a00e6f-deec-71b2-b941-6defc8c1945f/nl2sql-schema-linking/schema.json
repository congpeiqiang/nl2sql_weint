{
  "tables": [
    {
      "name": "titles",
      "description": "IMDb 核心作品表，评分和投票数已从 ratings 表合并到此表（反规范化）",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "note": "IMDb 唯一作品标识 tt+7-8位数字"},
        {"name": "title_type", "type": "VARCHAR", "note": "作品类型: movie/short/tvEpisode/tvSeries/tvMovie/tvMiniSeries/tvSpecial/video/videoGame"},
        {"name": "primary_title", "type": "VARCHAR", "note": "主要标题（通常为原始语言标题）"},
        {"name": "original_title", "type": "VARCHAR", "note": "原始标题"},
        {"name": "is_adult", "type": "INTEGER", "note": "是否成人内容 0/1"},
        {"name": "start_year", "type": "INTEGER", "note": "首映年份，可能为 NULL"},
        {"name": "end_year", "type": "INTEGER", "note": "终映年份，电影通常为 NULL"},
        {"name": "runtime_minutes", "type": "INTEGER", "note": "片长（分钟）"},
        {"name": "average_rating", "type": "DOUBLE", "note": "IMDb 加权平均评分 1.0-10.0，投票数越高越可信"},
        {"name": "num_votes", "type": "INTEGER", "note": "用户投票总数"}
      ]
    }
  ],
  "relations": [],
  "field_mappings": {
    "电影标题": {"table": "titles", "field": "primary_title"},
    "上映年份": {"table": "titles", "field": "start_year"},
    "评分": {"table": "titles", "field": "average_rating"},
    "投票数": {"table": "titles", "field": "num_votes"},
    "宝藏片指数": {"table": "titles", "field": "average_rating / LOG10(num_votes + 1)"}
  },
  "filter_fields": {
    "title_type": "titles.title_type = 'movie'（只查电影）",
    "average_rating": "titles.average_rating >= 8.5（高分）",
    "num_votes": "titles.num_votes < 5000（冷门/低关注）",
    "start_year": "titles.start_year IS NOT NULL",
    "average_rating_is_not_null": "titles.average_rating IS NOT NULL"
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "note": "单表查询，无需 JOIN；评分与投票数均位于 titles 表"
  }
}
