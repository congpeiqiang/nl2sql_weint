{
  "user_intent": {
    "original_question": "统计电视剧系列的数量分布情况，包括：1) 电视剧系列总数；2) 按类型（genre）统计电视剧系列数量分布；3) 按首播年份统计电视剧系列数量趋势。请查询 imdb 数据库中与电视剧系列（title_type 为 tvSeries 或类似）相关的数据。",
    "domain": "imdb",
    "keywords": ["电视剧系列", "tvSeries", "数量分布", "genre", "类型", "首播年份", "start_year", "总数"],
    "intent_type": "query_series_distribution"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "tvSeries"}
    ],
    "fields_to_display": ["电视剧系列总数", "genre类型", "首播年份", "数量"]
  },
  "metrics": [
    {
      "name": "电视剧系列总数",
      "aliases": ["系列数量", "总数"],
      "formula": "COUNT(*) FROM titles WHERE title_type = 'tvSeries'",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    },
    {
      "name": "按类型数量分布",
      "aliases": ["genre分布"],
      "formula": "COUNT(*) GROUP BY genre",
      "related_tables": ["titles", "titles_genres", "genres"],
      "aggregation": "COUNT"
    },
    {
      "name": "按首播年份数量趋势",
      "aliases": ["年份趋势"],
      "formula": "COUNT(*) GROUP BY start_year",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电视剧系列类型",
      "condition": "title_type = 'tvSeries' 表示多季多集的电视剧系列"
    },
    {
      "id": "rule_002",
      "name": "start_year NULL处理",
      "condition": "start_year 可能为 NULL，查询时建议 WHERE start_year IS NOT NULL"
    },
    {
      "id": "rule_003",
      "name": "genre_id是字符串",
      "condition": "genres.id 存的是字符串如 'action', 'comedy'，不是数字ID"
    }
  ],
  "field_mappings": {
    "电视剧系列": "titles.title_type = 'tvSeries'",
    "类型": "titles_genres.genre_id / genres.id",
    "首播年份": "titles.start_year"
  },
  "historical_qa_pairs": [],
