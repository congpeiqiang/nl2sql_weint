{
  "user_intent": {
    "original_question": "查询1990年代（1990-1999）电影的平均评分",
    "domain": "movies, ratings",
    "keywords": ["电影", "评分", "平均", "1990年代", "1990-1999"],
    "intent_type": "query_average_rating_by_decade"
  },
  "entities": {
    "time_range": {"start": 1990, "end": 1999},
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": "BETWEEN", "value": [1990, 1999]}
    ],
    "fields_to_display": ["平均评分"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["average rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型过滤",
      "condition": "title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "NULL值处理-start_year",
      "condition": "start_year IS NOT NULL"
    },
    {
      "id": "rule_003",
      "name": "NULL值处理-average_rating",
      "condition": "average_rating IS NOT NULL"
    },
    {
      "id": "rule_004",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10，1990年代即 start_year BETWEEN 1990 AND 1999"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "评分": "titles.average_rating",
    "年份": "titles.start_year",
    "平均评分": "AVG(titles.average_rating)"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "作品类型",
      "content": "titles表包含9种作品类型，电影需过滤 title_type='movie'"
    },
    {
      "topic": "评分字段",
      "content": "average_rating 范围 1.0-10.0，为IMDb加权平均分"
    },
    {
      "topic": "NULL处理",
      "content": "start_year和average_rating可能为NULL，查询时需过滤"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.average_rating", "titles.start_year", "titles.title_type"],
    "filter_conditions": ["title_type = 'movie'", "start_year BETWEEN 1990 AND 1999", "average_rating IS NOT NULL"],
    "time_range": "1990-1999"
  },
