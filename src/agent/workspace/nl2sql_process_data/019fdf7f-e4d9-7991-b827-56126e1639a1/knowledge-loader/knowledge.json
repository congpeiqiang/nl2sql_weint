{
  "user_intent": {
    "original_question": "查询电影数量最多的5个电影类型",
    "domain": "imdb",
    "keywords": ["电影", "数量", "类型", "最多", "5个"],
    "intent_type": "query_top_genres_by_movie_count"
  },
  "entities": {
    "time_range": null,
    "filters": [{"field": "title_type", "operator": "=", "value": "movie"}],
    "fields_to_display": ["电影类型", "电影数量"],
    "limit": 5
  },
  "metrics": [
    {
      "name": "电影数量",
      "aliases": ["电影数", "作品数"],
      "formula": "COUNT(DISTINCT titles.id)",
      "related_tables": ["titles", "titles_genres", "genres"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型过滤",
      "condition": "titles.title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "类型关联",
      "condition": "titles_genres.title_id = titles.id AND titles_genres.genre_id = genres.id"
    }
  ],
  "field_mappings": {
    "电影类型": "genres.display_name",
    "电影数量": "COUNT(DISTINCT titles.id)"
  },
