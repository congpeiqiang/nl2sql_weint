{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb唯一作品标识"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvEpisode/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "average_rating", "type": "DOUBLE", "description": "IMDb加权平均评分(1.0-10.0)"},
        {"name": "num_votes", "type": "INTEGER", "description": "用户投票总数"},
        {"name": "start_year", "type": "INTEGER", "description": "首映年份"},
        {"name": "end_year", "type": "INTEGER", "description": "终映年份"}
      ]
    },
    {
      "name": "episodes",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "剧集ID"},
        {"name": "parent_id", "type": "VARCHAR", "fk": true, "description": "父系列ID"},
        {"name": "season_number", "type": "INTEGER", "description": "季号"},
        {"name": "episode_number", "type": "INTEGER", "description": "集号"}
      ]
    }
  ],
  "relations": [
    {
      "from": "episodes",
      "from_field": "parent_id",
      "to": "titles",
      "to_field": "id",
      "description": "剧集 → 父系列"
    },
    {
      "from": "episodes",
      "from_field": "id",
      "to": "titles",
      "to_field": "id",
      "description": "剧集 → 自身标题(剧集评分)"
    }
  ],
  "field_mappings": {
    "电视剧系列": {"table": "titles", "field": "primary_title", "condition": "title_type='tvSeries'"},
    "季号": {"table": "episodes", "field": "season_number"},
    "剧集评分": {"table": "titles", "field": "average_rating"},
    "系列ID": {"table": "titles", "field": "id"},
    "剧集ID": {"table": "episodes", "field": "id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
