{
  "SELECT": "titles.primary_title (标题), titles.average_rating (评分)",
  "FROM": "titles",
  "JOIN": null,
  "WHERE": [
    "titles.title_type = 'tvSeries' (电视剧系列)",
    "titles.num_votes > 10000 (评分可信度过滤)",
    "titles.average_rating IS NOT NULL (排除无评分)"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "titles.average_rating DESC (评分从高到低)",
  "LIMIT": 10
}
