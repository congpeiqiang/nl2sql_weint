{
  "SELECT": [
    "titles.primary_title AS series_title",
    "COUNT(*) AS total_seasons",
    "首季平均评分 (first_season_rating)",
    "末季平均评分 (last_season_rating)",
    "ROUND((first_season_rating - last_season_rating) / first_season_rating * 100, 2) AS decline_rate_pct"
  ],
  "FROM": "titles s (series), episodes e, titles ep (episode)",
  "JOIN": [
    {"table": "episodes e", "on": "s.id = e.parent_id"},
    {"table": "titles ep", "on": "e.id = ep.id"}
  ],
  "WHERE": [
    "s.title_type = 'tvSeries'",
    "ep.average_rating IS NOT NULL",
    "e.season_number IS NOT NULL"
  ],
  "GROUP_BY": "s.id, s.primary_title, e.season_number (season_ratings CTE); 再按 s.id, s.primary_title (series_stats CTE)",
  "HAVING": "COUNT(*) >= 3 (至少3季)",
  "ORDER_BY": "decline_rate_pct DESC",
  "LIMIT": "通过 run_sql limit 参数控制"
}
