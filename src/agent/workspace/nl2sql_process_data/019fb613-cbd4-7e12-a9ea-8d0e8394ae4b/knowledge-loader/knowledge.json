{
  "user_intent": {
    "original_question": "列出时长大于 180 的电影标题和片长，按片长降序排列。",
    "domain": "imdb",
    "keywords": ["电影", "时长", "片长", "标题", "180", "降序"],
    "intent_type": "query_movies_by_runtime"
  },
  "entities": {
    "filters": [{"field": "runtime_minutes", "operator": ">", "value": 180}],
    "fields_to_display": ["primary_title", "runtime_minutes"],
    "order_by": {"field": "runtime_minutes", "direction": "DESC"}
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_movie_type",
      "name": "电影类型过滤",
      "condition": "titles.title_type = 'movie'",
      "content": "查询\"电影\"时必须过滤 title_type = 'movie'，titles 表包含9种作品类型"
    },
    {
      "id": "rule_runtime_null",
      "name": "片长NULL处理",
      "condition": "runtime_minutes > 180 自然排除 NULL",
      "content": "runtime_minutes 可能为 NULL，但 > 180 条件会自动排除 NULL 值"
    }
  ],
  "field_mappings": {
    "电影标题": "titles.primary_title",
    "片长": "titles.runtime_minutes"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "表关系",
      "content": "titles 表包含所有作品信息，primary_title 为主要标题，runtime_minutes 为片长"
    },
    {
      "topic": "字段说明",
      "content": "titles.title_type 可选值: movie/short/tvSeries/tvEpisode/tvMovie/tvMiniSeries/tvSpecial/video/videoGame"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.primary_title", "titles.runtime_minutes"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.runtime_minutes > 180"],
    "order_by": "titles.runtime_minutes DESC"
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "B"
  }
}
