{
  "user_intent": {
    "original_question": "查询每个类型中评分最高的电影，显示类型名、电影标题和评分",
    "domain": "imdb",
    "keywords": ["类型", "评分最高", "电影", "类型名", "电影标题", "评分"],
    "intent_type": "query_top_rated_movie_per_genre"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "num_votes", "operator": ">", "value": 10000}
    ],
    "fields_to_display": ["类型名", "电影标题", "评分"]
  },
  "metrics": [
    {
      "name": "最高评分",
      "aliases": ["评分最高", "最高分"],
      "formula": "MAX(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "MAX"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "评分可信度过滤",
      "condition": "t.num_votes > 10000",
      "note": "排名类查询应加 num_votes > 10000 过滤"
    },
    {
      "id": "rule_003",
      "name": "评分非空",
      "condition": "t.average_rating IS NOT NULL"
    }
  ],
  "field_mappings": {
    "类型名": {"table": "genres", "field": "display_name"},
    "电影标题": {"table": "titles", "field": "primary_title"},
    "评分": {"table": "titles", "field": "average_rating"}
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "表关系",
      "content": "titles ←→ titles_genres ←→ genres，通过 titles_genres.title_id = titles.id 和 titles_genres.genre_id = genres.id 关联"
    },
    {
      "topic": "字段说明",
      "content": "genres.id 是字符串（如 'action'），genres.display_name 是类型显示名；titles.primary_title 是电影标题；titles.average_rating 是评分"
    },
    {
      "topic": "JOIN路径",
      "content": "SELECT ... FROM titles t JOIN titles_genres tg ON tg.title_id = t.id JOIN genres g ON g.id = tg.genre_id"
    }
  ],
  "context_summary": {
    "main_tables": ["titles", "titles_genres", "genres"],
    "main_fields": ["genres.display_name", "titles.primary_title", "titles.average_rating"],
