{
  "SELECT": [
    "track.trackid AS 曲目ID",
    "track.name AS 曲目名称",
    "album.title AS 所属专辑",
    "genre.name AS 类型",
    "track.milliseconds AS 时长毫秒",
    "track.unitprice AS 单价"
  ],
  "FROM": "track",
  "JOIN": [
    {"table": "album", "on": "track.albumid = album.albumid", "type": "LEFT JOIN"},
    {"table": "genre", "on": "track.genreid = genre.genreid", "type": "LEFT JOIN"}
  ],
  "WHERE": [],
  "GROUP_BY": [],
  "HAVING": [],
  "ORDER_BY": "track.trackid ASC",
  "LIMIT": "不写 LIMIT，改用 run_sql limit 参数（规范要求）",
  "TOTAL_COUNT_SUBQUERY": "SELECT COUNT(*) FROM track"
}
