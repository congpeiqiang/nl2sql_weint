{
  "SELECT": "series_title (s.primary_title), total_seasons, first_season_rating, last_season_rating, decline_rate_pct",
  "FROM": "titles s (series), episodes e, titles ep (episode)",
  "JOIN": [
    {"table": "episodes e", "on": "s.id = e.parent_id"},
    {"table": "titles ep", "on": "e.id = ep.id"}
  ],
  "WHERE": [
    "s.title_type = 'tvSeries'",
    "ep.average_rating IS NOT NULL",
    "e.season_number IS NOT NULL"
  ],
  "GROUP_BY": "s.id, s.primary_title, e.season_number (CTE season_ratings)",
  "HAVING": "COUNT(*) >= 3 (至少3季)",
  "ORDER_BY": "decline_rate_pct DESC",
  "LIMIT": 10,
  "notes": {
    "decline_rate_pct": "ROUND((first_season_rating - last_season_rating) / first_season_rating * 100, 2)",
    "first_season_rating": "首季平均评分",
    "last_season_rating": "末季平均评分",
    "cte": "season_ratings 计算每季平均评分; series_stats 计算首末季评分"
  }
}
