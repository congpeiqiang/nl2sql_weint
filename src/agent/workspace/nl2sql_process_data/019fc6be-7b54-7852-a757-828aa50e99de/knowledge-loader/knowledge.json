{
  "user_intent": {
    "original_question": "查询 1990 年代（1990-1999）电影的平均评分",
    "domain": "imdb",
    "keywords": ["1990年代", "1990-1999", "电影", "平均评分"],
    "intent_type": "query_movie_avg_rating_by_decade"
  },
  "entities": {
    "time_range": {"start": 1990, "end": 1999, "type": "decade"},
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": "BETWEEN", "value": [1990, 1999]}
    ],
    "fields_to_display": ["平均评分"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg rating", "average rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_movie_type",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_null_year",
      "name": "start_year NULL 处理",
      "condition": "t.start_year IS NOT NULL"
    },
    {
      "id": "rule_decade",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10，1990年代即 start_year BETWEEN 1990 AND 1999"
    },
    {
      "id": "rule_rating_credibility",
      "name": "评分可信度",
      "condition": "排名类查询建议 num_votes > 10000；简单平均聚合可选"
    }
  ],
