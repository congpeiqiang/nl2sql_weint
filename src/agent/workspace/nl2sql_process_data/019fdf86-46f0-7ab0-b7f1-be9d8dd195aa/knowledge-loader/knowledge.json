  "knowledge": [
    {
      "topic": "表关系",
      "content": "titles ←→ titles_genres ←→ genres，通过 title_id 和 genre_id 关联"
    },
    {
      "topic": "字段说明",
      "content": "genres 表: id(字符串), display_name(类型显示名); titles_genres 联合主键 (title_id, genre_id)"
