{
  "user_intent": {
    "original_question": "查询电影 \"The Matrix\" 有哪些演员参演？显示演员姓名和角色排序",
    "domain": "imdb",
    "keywords": ["电影", "The Matrix", "演员", "演员姓名", "角色排序"],
    "intent_type": "query_movie_actors"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "titles.primary_title", "operator": "=", "value": "The Matrix"},
      {"field": "titles.title_type", "operator": "=", "value": "movie"},
      {"field": "principals.category_id", "operator": "IN", "value": ["actor", "actress"]}
    ],
    "fields_to_display": ["演员姓名", "角色排序"]
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_actor",
      "name": "演员定义规则",
      "condition": "category_id IN ('actor', 'actress')",
      "note": "IMDb 按性别区分，但业务上\"演员\"应包含 actor 和 actress 两者"
    },
    {
      "id": "rule_ordering",
      "name": "角色排序",
      "condition": "principals.ordering",
      "note": "ordering=1 为主演，值越小越重要"
    },
    {
      "id": "rule_movie",
      "name": "电影类型",
      "condition": "titles.title_type = 'movie'",
      "note": "title_type='movie' 才是电影"
    }
  ],
  "field_mappings": {
    "演员姓名": "names.primary_name",
    "角色排序": "principals.ordering",
    "电影标题": "titles.primary_title",
    "作品ID": "titles.id",
    "人物ID": "names.id"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "表关系",
      "content": "核心路径：titles ←→ principals ←→ names。titles.id = principals.title_id, principals.name_id = names.id"
    },
    {
      "topic": "角色路径",
      "content": "principals ←→ principals_characters 记录演员在作品中饰演的角色名"
    },
    {
      "topic": "字段说明",
      "content": "principals.ordering 为重要性排序，1=最主要角色，值越小越重要"
    },
    {
      "topic": "多表JOIN必须指定别名",
      "content": "SELECT t.primary_title, n.primary_name FROM titles t JOIN principals p ON t.id = p.title_id JOIN names n ON p.name_id = n.id"
    }
  ],
  "context_summary": {
    "main_tables": ["titles", "principals", "names"],
    "main_fields": ["titles.primary_title", "names.primary_name", "principals.ordering", "principals.category_id"],
    "filter_conditions": [
      "titles.primary_title = 'The Matrix'",
      "titles.title_type = 'movie'",
      "principals.category_id IN ('actor', 'actress')"
    ],
    "time_range": null
  },
