{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "description": "主要标题"},
        {"name": "original_title", "type": "VARCHAR", "description": "原始标题"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true, "description": "自增主键"},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "人物ID, 关联 names.id"},
        {"name": "ordering", "type": "INTEGER", "description": "排序号(1=最主要角色, 值越小越重要)"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别 (actor/actress/director等)"}
      ]
    },
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头)"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名"}
      ]
    }
  ],
  "relations": [
    {
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "name": "principals_titles"
    },
    {
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "name": "principals_names"
    }
  ],
  "field_mappings": {
    "电影标题": {"table": "titles", "field": "primary_title"},
    "作品类型": {"table": "titles", "field": "title_type"},
    "演员姓名": {"table": "names", "field": "primary_name"},
    "角色排序": {"table": "principals", "field": "ordering"},
    "职位类别": {"table": "principals", "field": "category_id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
