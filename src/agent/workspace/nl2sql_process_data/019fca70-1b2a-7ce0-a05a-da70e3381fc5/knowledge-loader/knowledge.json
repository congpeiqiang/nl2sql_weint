    "fields_to_display": ["平均评分"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_movie",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_null",
      "name": "NULL值处理",
      "condition": "start_year IS NOT NULL, average_rating IS NOT NULL"
    },
    {
      "id": "rule_decade",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "平均评分": "AVG(titles.average_rating)",
    "年代": "FLOOR(titles.start_year / 10) * 10",
    "上映年份": "titles.start_year"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "评分可信度",
      "content": "average_rating 为 IMDb 加权平均分(1.0-10.0)，num_votes 越高越可信"
    },
    {
      "topic": "年代计算",
      "content": "年代(decade) = FLOOR(start_year / 10) * 10，1990年代即 start_year BETWEEN 1990 AND 1999"
