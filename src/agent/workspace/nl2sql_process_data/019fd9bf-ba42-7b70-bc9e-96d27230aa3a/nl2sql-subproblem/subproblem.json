{
  "SELECT": "t.primary_title AS 标题, t.average_rating AS 评分",
  "FROM": "titles t",
  "JOIN": null,
  "WHERE": [
    "t.title_type = 'movie'",
    "t.num_votes > 10000",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "t.average_rating DESC",
  "LIMIT": 10
}
