{
  "SELECT": "FLOOR(t.start_year / 10) * 10 AS decade, AVG(t.average_rating) AS avg_rating, COUNT(*) AS movie_count",
  "FROM": "titles t",
  "JOIN": null,
  "WHERE": [
    "t.title_type = 'movie'",
    "t.start_year IS NOT NULL",
    "t.average_rating IS NOT NULL"
  ],
  "GROUP_BY": "FLOOR(t.start_year / 10) * 10",
  "HAVING": null,
  "ORDER_BY": "decade ASC",
  "LIMIT": null
}
