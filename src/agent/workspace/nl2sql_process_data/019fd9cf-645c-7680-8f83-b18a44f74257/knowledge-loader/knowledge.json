{
  "user_intent": {
    "original_question": "按十年分组统计电影的平均评分和数量",
    "domain": "imdb",
    "keywords": ["十年", "分组", "电影", "平均评分", "数量"],
    "intent_type": "query_movie_rating_by_decade"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": "IS NOT NULL"},
      {"field": "average_rating", "operator": "IS NOT NULL"}
    ],
    "fields_to_display": ["年代(decade)", "平均评分", "电影数量"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    },
    {
      "name": "电影数量",
      "aliases": ["数量", "count", "电影数"],
      "formula": "COUNT(*)",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_decade",
      "name": "年代划分公式",
      "condition": "FLOOR(start_year / 10) * 10",
      "note": "1994 -> 1990, 2005 -> 2000, 2023 -> 2020"
    },
    {
      "id": "rule_movie",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_null",
      "name": "NULL值处理",
      "condition": "start_year IS NOT NULL AND average_rating IS NOT NULL"
    }
  ],
  "field_mappings": {
    "年代": {"table": "titles", "field": "start_year", "transform": "FLOOR(start_year/10)*10"},
    "平均评分": {"table": "titles", "field": "average_rating"},
    "电影数量": {"table": "titles", "field": "id", "aggregation": "COUNT"}
  },
