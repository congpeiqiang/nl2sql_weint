{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "note": "IMDb唯一作品标识 tt+7-8位数字"},
        {"name": "title_type", "type": "VARCHAR", "note": "movie/short/tvSeries/tvEpisode/tvMovie/tvMiniSeries/tvSpecial/video/videoGame"},
        {"name": "start_year", "type": "INTEGER", "note": "首映/发布年份，可能为NULL"},
        {"name": "average_rating", "type": "DOUBLE", "note": "IMDb加权平均评分(1.0-10.0)"},
        {"name": "num_votes", "type": "INTEGER", "note": "用户投票总数"}
      ]
    }
  ],
  "relations": [],
  "field_mappings": {
    "年代": {"table": "titles", "field": "start_year", "transform": "FLOOR(start_year/10)*10"},
    "平均评分": {"table": "titles", "field": "average_rating", "aggregation": "AVG"},
    "电影数量": {"table": "titles", "field": "id", "aggregation": "COUNT"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "note": "单表查询，仅需 titles 表。数据源为 mysql。"
  }
}
