{
  "tables": [
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb唯一作品标识"},
        {"name": "title_type", "type": "VARCHAR", "pk": false, "description": "作品类型: movie/short/tvSeries等"},
        {"name": "primary_title", "type": "VARCHAR", "pk": false, "description": "主要标题"},
        {"name": "runtime_minutes", "type": "INTEGER", "pk": false, "description": "片长(分钟), 可能为NULL"}
      ]
    }
  ],
  "relations": [],
  "field_mappings": {
    "电影标题": {"table": "titles", "field": "primary_title"},
    "片长": {"table": "titles", "field": "runtime_minutes"},
    "电影类型": {"table": "titles", "field": "title_type"}
  },
  "filter_conditions": [
    "titles.title_type = 'movie'",
    "titles.runtime_minutes > 180",
    "titles.runtime_minutes IS NOT NULL"
  ],
  "order_by": "titles.runtime_minutes DESC",
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "note": "单表查询，仅需titles表，无需JOIN"
  }
}
