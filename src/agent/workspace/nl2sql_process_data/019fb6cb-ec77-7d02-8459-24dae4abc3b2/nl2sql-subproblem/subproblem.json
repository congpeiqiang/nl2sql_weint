{
  "SELECT": "names.primary_name AS actor_name, principals.ordering",
  "FROM": "titles t JOIN principals p ON t.id = p.title_id JOIN names n ON p.name_id = n.id",
  "JOIN": [
    {"table": "principals", "on": "titles.id = principals.title_id"},
    {"table": "names", "on": "principals.name_id = names.id"}
  ],
  "WHERE": [
    "titles.primary_title = 'The Matrix'",
    "titles.title_type = 'movie'",
    "principals.category_id IN ('actor', 'actress')"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "principals.ordering ASC",
  "LIMIT": null
}
