{
  "SELECT": "genres.display_name AS 类型, COUNT(DISTINCT titles.id) AS 电影数量",
  "FROM": "titles t, titles_genres tg, genres g",
  "JOIN": [
    {"table": "titles_genres", "on": "titles.id = titles_genres.title_id"},
    {"table": "genres", "on": "titles_genres.genre_id = genres.id"}
  ],
  "WHERE": ["titles.title_type = 'movie'"],
  "GROUP_BY": "genres.display_name",
  "HAVING": null,
  "ORDER_BY": "电影数量 DESC",
  "LIMIT": null
}
