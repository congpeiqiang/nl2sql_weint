      "topic": "字段说明",
      "content": "titles.average_rating 为 DOUBLE，范围 1.0-10.0；titles.start_year 为 INTEGER，可能为 NULL"
    },
    {
      "topic": "年代计算",
      "content": "年代(decade) = FLOOR(start_year / 10) * 10；1990年代 = start_year BETWEEN 1990 AND 1999"
