{
  "user_intent": {
    "original_question": "查询 1990 年代（1990-1999）电影的平均评分",
    "domain": "imdb",
    "keywords": ["电影", "平均评分", "1990年代", "1990-1999"],
    "intent_type": "query_avg_rating_by_decade"
  },
  "entities": {
    "time_range": {"start": 1990, "end": 1999},
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": "BETWEEN", "value": [1990, 1999]}
    ],
    "fields_to_display": ["平均评分"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["平均分", "avg rating"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10；1990年代即 start_year BETWEEN 1990 AND 1999"
    },
    {
      "id": "rule_003",
      "name": "NULL值处理",
      "condition": "start_year IS NOT NULL；average_rating IS NOT NULL"
    },
    {
      "id": "rule_004",
      "name": "评分可信度",
      "condition": "排名类查询应加 num_votes > 10000 过滤；平均评分聚合统计可直接 AVG"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "平均评分": "AVG(titles.average_rating)",
    "年份": "titles.start_year"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "表关系",
      "content": "titles 表包含 average_rating 和 num_votes 字段，可直接聚合"
    },
