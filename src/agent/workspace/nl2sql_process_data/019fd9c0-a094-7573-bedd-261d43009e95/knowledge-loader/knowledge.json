{
  "user_intent": {
    "original_question": "统计 2020 年之后（含 2020）共有多少部电影",
    "domain": "imdb",
    "keywords": ["电影", "2020", "统计", "数量"],
    "intent_type": "count_movies_after_2020"
  },
  "entities": {
    "time_range": {"start": "2020", "end": null},
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": ">=", "value": 2020}
    ],
    "fields_to_display": ["count"]
  },
  "metrics": [
    {
      "name": "电影数量",
      "aliases": ["多少部电影", "电影总数"],
      "formula": "COUNT(*) WHERE title_type='movie' AND start_year >= 2020",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_movie_type",
      "name": "电影类型定义",
      "condition": "titles.title_type = 'movie'"
    },
    {
      "id": "rule_null_year",
      "name": "start_year 可能为 NULL",
      "condition": "WHERE start_year IS NOT NULL"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "年份": "titles.start_year"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "作品类型",
      "content": "title_type='movie' 表示长片电影，通常 runtime >= 40 分钟"
    },
    {
      "topic": "字段说明",
      "content": "titles.start_year 为首映/发布年份，可能为 NULL"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.title_type", "titles.start_year"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.start_year >= 2020"],
    "time_range": "2020 onwards"
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "B",
    "timestamp": "2026-07-28T10:00:00"
  }
}
