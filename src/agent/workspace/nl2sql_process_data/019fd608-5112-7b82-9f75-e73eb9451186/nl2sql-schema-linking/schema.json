      ]
    }
  ],
  "relations": [
    {
      "from": "titles_genres",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id"
    },
    {
      "from": "titles_genres",
      "from_field": "genre_id",
      "to": "genres",
      "to_field": "id"
    }
  ],
  "field_mappings": {
    "类型名": {"table": "genres", "field": "display_name"},
    "电影标题": {"table": "titles", "field": "primary_title"},
    "评分": {"table": "titles", "field": "average_rating"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
