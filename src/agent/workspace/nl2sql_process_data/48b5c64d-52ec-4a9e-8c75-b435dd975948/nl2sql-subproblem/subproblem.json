{
  "SELECT": "titles.primary_title AS title, titles.average_rating AS rating",
  "FROM": "titles",
  "JOIN": null,
  "WHERE": [
    "titles.title_type = 'tvSeries'",
    "titles.num_votes > 10000",
    "titles.average_rating IS NOT NULL"
  ],
  "GROUP_BY": null,
  "HAVING": null,
  "ORDER_BY": "titles.average_rating DESC",
  "LIMIT": 10
}
