{
  "tables": [
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "ref": "titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "ref": "names.id"},
        {"name": "ordering", "type": "INTEGER"},
        {"name": "category_id", "type": "VARCHAR", "fk": true, "ref": "categories.code"},
        {"name": "job_id", "type": "VARCHAR", "fk": true, "ref": "jobs.code"}
      ]
    },
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true},
        {"name": "title_type", "type": "VARCHAR"},
        {"name": "primary_title", "type": "VARCHAR"},
        {"name": "original_title", "type": "VARCHAR"},
        {"name": "is_adult", "type": "INTEGER"},
        {"name": "start_year", "type": "INTEGER"},
        {"name": "end_year", "type": "INTEGER"},
        {"name": "runtime_minutes", "type": "INTEGER"},
        {"name": "average_rating", "type": "DOUBLE"},
        {"name": "num_votes", "type": "INTEGER"}
      ]
    },
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true},
        {"name": "primary_name", "type": "VARCHAR"},
        {"name": "birth_year", "type": "INTEGER"},
        {"name": "death_year", "type": "INTEGER"}
      ]
    }
  ],
  "relations": [
    {"from": "principals", "from_field": "title_id", "to": "titles", "to_field": "id"},
    {"from": "principals", "from_field": "name_id", "to": "names", "to_field": "id"}
  ],
  "field_mappings": {
    "导演名": {"table": "names", "field": "primary_name", "alias": "d", "condition": "category_id='director'"},
    "演员名": {"table": "names", "field": "primary_name", "alias": "a", "condition": "category_id IN ('actor','actress')"},
    "合作次数": {"table": "principals", "field": "COUNT(*)"},
    "平均评分": {"table": "titles", "field": "AVG(average_rating)"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "datasource": "mysql",
    "notes": "principals 需自关联两次：pd(导演) 和 pa(演员)。titles 需过滤 title_type='movie'，num_votes>5000，average_rating IS NOT NULL"
  }
}
