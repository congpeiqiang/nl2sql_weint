      "name": "平均评分",
      "aliases": ["avg_rating", "平均分"],
      "formula": "AVG(t.average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    },
    {
      "name": "电影数量",
      "aliases": ["count", "数量"],
      "formula": "COUNT(*)",
      "related_tables": ["titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_decade",
