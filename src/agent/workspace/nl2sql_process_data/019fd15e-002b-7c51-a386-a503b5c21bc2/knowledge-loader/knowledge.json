{
  "user_intent": {
    "original_question": "按十年分组统计电影的平均评分和数量。即按 start_year 每十年为一个区间（如 1900-1909、1910-1919、...、2020-2029），统计每个十年区间内电影（title_type='movie'）的数量和平均评分。",
    "domain": "imdb",
    "keywords": ["十年", "分组", "电影", "平均评分", "数量", "start_year", "title_type", "movie"],
    "intent_type": "query_decade_movie_stats"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": "IS NOT NULL"}
    ],
    "fields_to_display": ["decade", "movie_count", "avg_rating"],
    "group_by": "decade (FLOOR(start_year/10)*10)"
  },
  "metrics": [
