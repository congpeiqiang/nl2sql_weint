{
  "user_intent": {
    "original_question": "1990 年代上映的电影平均评分是多少？",
    "domain": "imdb",
    "keywords": ["1990年代", "电影", "平均评分"],
    "intent_type": "query_avg_rating_by_decade"
  },
  "entities": {
    "time_range": {"decade": "1990s", "start_year": 1990, "end_year": 1999},
    "filters": [{"field": "title_type", "operator": "=", "value": "movie"}, {"field": "decade", "operator": "=", "value": 1990}],
    "fields_to_display": ["平均评分"]
  },
  "metrics": [
    {
      "name": "平均评分",
      "aliases": ["avg_rating", "平均评分"],
      "formula": "AVG(average_rating)",
      "related_tables": ["titles"],
      "aggregation": "AVG"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "电影类型过滤",
      "condition": "title_type = 'movie'"
    },
    {
      "id": "rule_002",
      "name": "年代划分",
      "condition": "FLOOR(start_year / 10) * 10 = 1990"
    },
    {
      "id": "rule_003",
      "name": "NULL处理",
      "condition": "start_year IS NOT NULL"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "上映年份": "titles.start_year",
    "平均评分": "AVG(titles.average_rating)"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "Cube指标",
      "content": "movie_analytics cube 提供 avg_rating 度量（AVG(average_rating)）和 decade 维度（FLOOR(start_year/10)*10），可直接用于按年代查询平均评分"
    },
    {
      "topic": "年代划分",
      "content": "年代计算公式 FLOOR(start_year / 10) * 10，1994 → 1990"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.average_rating", "titles.start_year", "titles.title_type"],
    "filter_conditions": ["title_type = 'movie'", "decade = 1990"],
    "time_range": "1990s (1990-1999)"
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "C (Cube channel)",
    "cube": "movie_analytics",
    "measure": "avg_rating",
    "dimension": "decade"
  }
}
