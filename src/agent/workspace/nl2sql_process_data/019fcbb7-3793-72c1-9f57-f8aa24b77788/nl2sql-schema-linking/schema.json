{
  "tables": [
    {
      "name": "names",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一人物标识 (nm开头7-8位字符串)"},
        {"name": "primary_name", "type": "VARCHAR", "description": "全名(最常用拼写形式)"}
      ]
    },
    {
      "name": "principals",
      "columns": [
        {"name": "id", "type": "INTEGER", "pk": true, "description": "自增主键"},
        {"name": "title_id", "type": "VARCHAR", "fk": true, "description": "作品ID, 关联 titles.id"},
        {"name": "name_id", "type": "VARCHAR", "fk": true, "description": "人物ID, 关联 names.id"},
        {"name": "category_id", "type": "VARCHAR", "description": "职位类别 (actor/actress/director等)"}
      ]
    },
    {
      "name": "titles",
      "columns": [
        {"name": "id", "type": "VARCHAR", "pk": true, "description": "IMDb 唯一作品标识 (tt开头7-8位字符串)"},
        {"name": "title_type", "type": "VARCHAR", "description": "作品类型: movie/short/tvEpisode/tvSeries等"}
      ]
    }
  ],
  "relations": [
    {
      "name": "principals_titles",
      "from": "principals",
      "from_field": "title_id",
      "to": "titles",
      "to_field": "id",
      "join_type": "MANY_TO_ONE"
    },
    {
      "name": "principals_names",
      "from": "principals",
      "from_field": "name_id",
      "to": "names",
      "to_field": "id",
      "join_type": "MANY_TO_ONE"
    }
  ],
  "field_mappings": {
    "演员姓名": {"table": "names", "field": "primary_name"},
    "参演电影数": {"table": "principals", "field": "title_id", "aggregation": "COUNT DISTINCT"},
    "作品类型": {"table": "titles", "field": "title_type"},
    "职位类别": {"table": "principals", "field": "category_id"}
  },
  "metadata": {
    "phase": "schema_extracted",
    "status": "success",
    "data_source": "mysql"
  }
}
