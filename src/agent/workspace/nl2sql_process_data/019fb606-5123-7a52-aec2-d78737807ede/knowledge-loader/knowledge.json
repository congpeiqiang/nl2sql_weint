{
  "user_intent": {
    "original_question": "2020 年之后（含 2020）共有多少部电影？",
    "domain": "imdb",
    "keywords": ["2020", "电影", "数量"],
    "intent_type": "count_movies_since_2020"
  },
  "entities": {
    "time_range": {"start": 2020, "end": null},
    "filters": [
      {"field": "title_type", "operator": "=", "value": "movie"},
      {"field": "start_year", "operator": ">=", "value": 2020}
    ],
    "fields_to_display": ["count"]
  },
  "metrics": [],
  "business_rules": [
    {
      "id": "rule_movie",
      "name": "电影类型定义",
      "condition": "titles.title_type = 'movie'"
    },
    {
      "id": "rule_null_year",
      "name": "start_year 可能为 NULL",
      "condition": "WHERE start_year IS NOT NULL"
    }
  ],
  "field_mappings": {
    "电影": "titles.title_type = 'movie'",
    "年份": "titles.start_year"
  },
  "historical_qa_pairs": [],
  "knowledge": [
    {
      "topic": "作品类型",
      "content": "title_type = 'movie' 才是电影，titles 表包含9种作品类型"
    },
    {
      "topic": "NULL处理",
      "content": "start_year 可能为 NULL，查询时建议 WHERE start_year IS NOT NULL"
    }
  ],
  "context_summary": {
    "main_tables": ["titles"],
    "main_fields": ["titles.title_type", "titles.start_year"],
    "filter_conditions": ["titles.title_type = 'movie'", "titles.start_year >= 2020"],
    "time_range": "2020 onwards"
  },
  "metadata": {
    "phase": "knowledge_loaded",
    "status": "success",
    "strategy": "B"
  }
}
