{
  "SELECT": "titles.start_year AS year, ROUND(AVG(titles.average_rating), 2) AS avg_rating",
  "FROM": "titles",
  "JOIN": null,
  "WHERE": [
    "titles.title_type = 'tvSeries'",
    "titles.start_year BETWEEN 2000 AND 2023",
    "titles.start_year IS NOT NULL",
    "titles.average_rating IS NOT NULL"
  ],
  "GROUP_BY": "titles.start_year",
  "HAVING": null,
  "ORDER_BY": "titles.start_year ASC",
  "LIMIT": null
}
