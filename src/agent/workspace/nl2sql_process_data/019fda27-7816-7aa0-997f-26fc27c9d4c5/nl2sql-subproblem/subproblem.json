{
  "SELECT": [
    {"field": "t.start_year", "alias": "year", "description": "年份"},
    {"field": "ROUND(AVG(t.average_rating), 2)", "alias": "avg_rating", "description": "平均评分"}
  ],
  "FROM": [
    {"table": "titles", "alias": "t"}
  ],
  "JOIN": [],
  "WHERE": [
    {"condition": "t.title_type = 'tvSeries'", "description": "只查电视剧系列"},
    {"condition": "t.start_year BETWEEN 2000 AND 2023", "description": "年份范围"},
    {"condition": "t.average_rating IS NOT NULL", "description": "排除无评分记录"},
    {"condition": "t.start_year IS NOT NULL", "description": "排除无年份记录"}
  ],
  "GROUP_BY": [
    {"field": "t.start_year", "description": "按年份分组"}
  ],
  "HAVING": [],
  "ORDER_BY": [
    {"field": "t.start_year", "direction": "ASC", "description": "按年份升序排列"}
  ],
  "LIMIT": null
}
