{
  "user_intent": {
    "original_question": "参演电影数量最多的前 10 位演员是谁？显示姓名和参演数量",
    "domain": "imdb",
    "keywords": ["演员", "电影", "参演数量", "前10"],
    "intent_type": "query_top_actors_by_movie_count"
  },
  "entities": {
    "time_range": null,
    "filters": [
      {"field": "category_id", "operator": "IN", "value": "('actor', 'actress')"},
      {"field": "title_type", "operator": "=", "value": "'movie'"}
    ],
    "fields_to_display": ["演员姓名", "参演电影数量"],
    "limit": 10
  },
  "metrics": [
    {
      "name": "参演电影数量",
      "aliases": ["作品总数", "movie_count"],
      "formula": "COUNT(DISTINCT p.title_id)",
      "related_tables": ["names", "principals", "titles"],
      "aggregation": "COUNT"
    }
  ],
  "business_rules": [
    {
      "id": "rule_001",
      "name": "演员定义规则",
      "condition": "category_id IN ('actor', 'actress')",
      "description": "IMDb按性别区分演员，业务上'演员'应包含actor和actress两者"
    },
    {
      "id": "rule_002",
      "name": "电影类型过滤",
      "condition": "t.title_type = 'movie'",
      "description": "只有title_type='movie'才是电影，需排除短片、电视剧等其他类型"
    }
  ],
  "field_mappings": {
    "演员姓名": "names.primary_name",
    "参演电影数量": "COUNT(DISTINCT principals.title_id)"
  },
  "historical_qa_pairs": [
    {
      "id": "hqa_001",
      "original_question": "高产演员分析（含多面手得分），找出参演高分电影最多的演员",
      "sql": "SELECT n.primary_name, COUNT(DISTINCT p.title_id) AS movie_count FROM names n JOIN principals p ON p.name_id = n.id JOIN titles t ON t.id = p.title_id WHERE p.category_id IN ('actor', 'actress') AND t.title_type = 'movie' GROUP BY n.id, n.primary_name ORDER BY movie_count DESC",
      "similarity_score": 0.85
    }
  ],
  "knowledge": [
    {
      "topic": "演员定义",
      "content": "查询'演员'时必须同时包含 category_id IN ('actor', 'actress')"
    },
    {
      "topic": "电影定义",
      "content": "title_type = 'movie' 才是电影，titles表包含9种作品类型"
    },
    {
      "topic": "多表JOIN路径",
      "content": "titles ←→ principals ←→ names"
    }
  ],
