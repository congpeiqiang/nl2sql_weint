{
  "SELECT": "n.primary_name AS actor_name, COUNT(DISTINCT p.title_id) AS movie_count",
  "FROM": "names n",
  "JOIN": [
    {"table": "principals p", "on": "p.name_id = n.id"},
    {"table": "titles t", "on": "t.id = p.title_id"}
  ],
  "WHERE": [
    "p.category_id IN ('actor', 'actress')",
    "t.title_type = 'movie'"
  ],
  "GROUP_BY": "n.id, n.primary_name",
  "HAVING": null,
  "ORDER_BY": "movie_count DESC",
  "LIMIT": 10
}
