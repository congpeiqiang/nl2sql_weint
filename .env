# ================================================
# Wren 可执行文件路径（正斜杠：dotenv 反斜杠会当转义字符，\n 等直接解析坏）
# ================================================
WREN_BIN_PATH=D:/code_work_space/llm/nl2sql/.venv/Scripts/wren.EXE
# Wren 记忆检索后端：grep（token-overlap，毫秒级）或 lancedb（向量检索，首次 3-10s）。
# 影响 MCP 子进程 + wren memory index CLI。当前知识库 <50 条，grep 足够。
WREN_MEMORY_BACKEND=grep

CHECKPOINT_DB_PATH=D:\code_work_space\llm\nl2sql\src\agent\workspace\checkpoint
CHART_ENGINE=echarts # semiotic echarts

# 数据库配置存储
DB_CONFIG_SECRET=b40629feb5e52e157b9065cb0626be7f

# 自定义 app 合并进 langgraph API（同进程/同端口 2026）
# db-config 路由由 src/api/custom_app.py 提供，不再独立跑 8008
LANGGRAPH_HTTP={"app": "src/api/custom_app.py:app"}
