DB_1_HOST=mysql-master
DB_1_PORT=3306
DB_1_USER=aoi-dev
DB_1_PASSWORD=aoi8dev.1234

# 数据库 2: Chinook_AutoIncrement
DB_2_NAME=Chinook_AutoIncrement
DB_2_HOST=mysql-master
DB_2_PORT=3306
DB_2_USER=aoi-dev
DB_2_PASSWORD=aoi8dev.1234

# 数据库 3: imdb
DB_3_NAME=imdb
DB_3_HOST=mysql-master
DB_3_PORT=3306
DB_3_USER=aoi-dev
