# M5 灰度/发版：release 标记（Langfuse Release 页分组；每次发版改一次，如 v0.5.0）
LANGFUSE_RELEASE="v0.5.0-m5"
# M5 A/B 分流（默认全 production；灰度/演练时打开下面任一组即可，回滚=删掉/清空）
# 显式指定：整进程固定用某 label（run_experiment 由 --labels 注入，不需要这里配）
# LANGFUSE_PROMPT_LABEL=prod-b
# canary 比例掷骰：约 ratio*N 个实例走 canary label，其余 production
# LANGFUSE_CANARY_LABEL=prod-b
# LANGFUSE_CANARY_RATIO=0.1

# ================================================
# 数据库配置（支持多数据库，_N 后缀区分）
# 前端下拉框自动读取所有数据库
# ================================================
