# NL2SQL 开发服务器环境变量（192.168.25.34）
# 部署位置：/home/weint/apps/nl2sql/nl2sql-app
# 用途：开发服务器部署，区别于本地开发（.env）和生产（.env.prod）
# 由 env_loader.py 在 DEPLOY_ENV=dev-server 时加载（覆盖 .env 基线）

DEPLOY_ENV=dev-server

# ================================================
# Langfuse 配置（开发服务器实例）
# ================================================
LANGFUSE_ENABLE=true
LANGFUSE_HOST="http://192.168.25.34:3010"
LANGFUSE_SECRET_KEY="sk-lf-local-pending"
LANGFUSE_PUBLIC_KEY="pk-lf-local-pending"
LANGFUSE_PROJECT_ID="nl2sql"
LANGFUSE_TRACING_ENVIRONMENT=dev-server
LANGFUSE_RELEASE="v0.5.0-m5"

# ================================================
# NL2SQL_EVAL_* 评估配置（开发服务器 Ollama）
# ================================================
NL2SQL_EVAL_PROVIDER=ollama
NL2SQL_EVAL_BASE_URL=http://192.168.25.34:11434
NL2SQL_EVAL_MODEL=qwen3.7-max
NL2SQL_EVAL_API_KEY=EMPTY

# ================================================
# 数据库配置（开发服务器 PostgreSQL）
# ================================================
DB_TYPE=postgresql

DB_1_NAME=aix_report
DB_1_HOST=192.168.25.34
DB_1_PORT=5432
DB_1_USER=nl2sql
DB_1_PASSWORD=nl2sql123

DB_2_NAME=Chinook_AutoIncrement
DB_2_HOST=192.168.25.34
DB_2_PORT=5432
DB_2_USER=nl2sql
DB_2_PASSWORD=nl2sql123

DB_3_NAME=imdb
DB_3_HOST=192.168.25.34
DB_3_PORT=5432
DB_3_USER=nl2sql
DB_3_PASSWORD=nl2sql123

# ================================================
# Wren 可执行文件路径（容器内）
# ================================================
WREN_BIN_PATH=/app/src/.venv/bin/wren
WREN_MEMORY_BACKEND=grep

# ================================================
# MCP stdio stderr 横幅屏蔽
# ================================================
MCP_SUPPRESS_BANNER=1

# ================================================
# 开发服务器不使用离线实验（注释掉）
# ================================================
# NL2SQL_EVAL_PROVIDER=ollama
# NL2SQL_EVAL_BASE_URL=http://ollama:11434
# NL2SQL_EVAL_MODEL=qwen3:8b
