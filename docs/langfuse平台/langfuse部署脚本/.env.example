# Langfuse v4 .env 模板（占位版，供仓库入库）
# 真实值不入库：在服务器 /home/weint/apps/nl2sql/langfuse/.env（权限 600）中维护。
# 用法：cp .env.example .env && 逐项填入真实值 && chmod 600 .env
#
# ⚠️ SALT / ENCRYPTION_KEY / NEXTAUTH_SECRET 一旦用于生产就绝不能更换：
#    SALT 是 API Key 的哈希盐（换了 pk/sk 全失效）；ENCRYPTION_KEY 用于解密已存的 LLM Connections。
#    三项可用 `openssl rand -hex 32` 生成。

NEXTAUTH_URL=http://<服务器IP>:3010
NEXTAUTH_SECRET=<openssl rand -hex 32>
SALT=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>

# PostgreSQL（compose 服务名 postgres；PG_PW 与 DATABASE_URL 中的密码必须一致）
DATABASE_URL=postgresql://langfuse:<PG_PW>@postgres:5432/langfuse
PG_PW=<PostgreSQL 密码>

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
# 目标库：迁移建表库 + 运行时读写库，必须与期望落库一致（本部署为 nl2sql）
# 该变量必须被 compose 注入 langfuse-web 与 langfuse-worker 才生效
CLICKHOUSE_DB=nl2sql
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=<ClickHouse 密码>
# 北京时间视图层库名（create_bj_views.sh 创建；供 BI / NL2SQL 读北京时间，存储仍为 UTC）
CLICKHOUSE_BJ_DB=langfuse_bj

REDIS_AUTH=<Redis 密码>

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<MinIO 密码>
# 媒体文件对外地址，必须浏览器可达（填容器名会导致页面图片裂开）
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://<服务器IP>:9090

# headless 初始化：管理员 / 组织 / 项目 / API Key（仅在 PG 中无对应记录时生效）
LANGFUSE_INIT_ORG_ID=org_xxxxxxxx
LANGFUSE_INIT_ORG_NAME=<组织名>
LANGFUSE_INIT_PROJECT_ID=proj_xxxxxxxx
LANGFUSE_INIT_PROJECT_NAME=<项目名>
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-xxxxxxxx
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-xxxxxxxx
LANGFUSE_INIT_USER_EMAIL=<管理员邮箱>
LANGFUSE_INIT_USER_NAME=<管理员名>
LANGFUSE_INIT_USER_PASSWORD=<管理员密码>

# v4 写入模式：dual = 同时写 v3 表与 v4 事件表（events_core / events_full）
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual
# v4 预览开关：**已由 docker-compose.yml 硬编码为字符串 "true"，不再从 .env 透传**，
# 故此处刻意注释掉——写在这行里的任何值都不会进容器。这是防「.env 里的显式值覆盖默认值」
# 的刻意设计（2026-09-18 事故根因，见 README §9.4）。它同时门控 API
# `/api/public/v2/observations`，是应用读路径的正确性前提，不是运维旋钮，勿改回透传。
# LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=true
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=false

# LLM Connections 出网白名单（防 SSRF）；须在 web 与 worker 两处都被 compose 引用才生效
LANGFUSE_LLM_CONNECTION_WHITELISTED_IPS=<允许出网的调用方IP>
